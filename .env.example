# Copy to .env.local and fill in.
# Anthropic API key for photo vision (M3), themes/refinement (M4+).
ANTHROPIC_API_KEY=
# Optional override for a model supporting vision and forced tool use.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Canonical base URL of the deployment, e.g. https://studio.example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
