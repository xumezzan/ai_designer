# Copy to .env.local and fill in.
# Anthropic API key for photo vision (M3), themes/refinement (M4+).
ANTHROPIC_API_KEY=
# Optional override for a model supporting vision and forced tool use.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Original artwork from the studio. Server-only; never use NEXT_PUBLIC_ for keys.
OPENAI_API_KEY=
# Explicit model supporting the Images generation/edit endpoints.
OPENAI_IMAGE_MODEL=gpt-image-2
# Canonical base URL of the deployment, e.g. https://studio.example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# M6: existing Playwright module and Chromium, configured on the server.
# No browser or dependency is downloaded by QA. Leave module empty if playwright is locally installed.
QA_PLAYWRIGHT_MODULE=
QA_CHROME_EXECUTABLE=
# Trusted origin used by the QA worker to load previews (not taken from a request).
QA_BASE_URL=http://127.0.0.1:3147
