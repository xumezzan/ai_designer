# Copy to .env.local and fill in.
# Optional private writable directory for the Taklif customer MVP.
# Default: .platform-data/ (gitignored). One Node process only.
# PLATFORM_DATA_DIR=/absolute/path/to/private/platform-data
# Paid generation attempts per owner in a rolling 24-hour window (1–20).
PLATFORM_AI_DAILY_LIMIT=3
# Anthropic API key for website design planning, references and photo vision.
ANTHROPIC_API_KEY=
# Optional override for a model supporting vision, JSON outputs and the operator studio's tool use.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Original artwork workflows. The customer theme catalog needs no image key.
# Server-only; never use NEXT_PUBLIC_ for keys.
OPENAI_API_KEY=
# Explicit model supporting the Images generation/edit endpoints.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Canonical base URL of the deployment, e.g. https://studio.example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# M6: existing Playwright module and Chromium, configured on the server.
# No browser or dependency is downloaded by QA. Leave module empty if playwright is locally installed.
QA_PLAYWRIGHT_MODULE=
QA_CHROME_EXECUTABLE=
# Trusted origin used by the QA worker to load previews (not taken from a request).
QA_BASE_URL=http://127.0.0.1:3147
