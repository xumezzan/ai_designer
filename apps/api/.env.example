# --- Core ---
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./invito.db            # postgresql+psycopg://user:pass@host:5432/invito
PUBLIC_SITE_BASE_URL=http://localhost:3000    # used to build public event URLs (https://invito.ai in prod)
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Local email/password JWT auth is built in. To accept Supabase Auth tokens instead, set:
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# --- Storage ---
STORAGE_BACKEND=local                          # local | s3
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Jobs ---
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=true                              # run AI jobs inline (no worker) in development

# --- AI ---
AI_PROVIDER=rules                              # rules | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
